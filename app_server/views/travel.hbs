<div id="contents">
	<div class="box">
		<div>
			<div class="body">
				<h1>Travel</h1>
				{{#if message}}
				<p>{{message}}</p>
				{{/if}}
				<ul id="sites">
					{{#each trips}}
					<li>
						<a href="/travel"><img src="{{this.image}}" alt="{{this.name}}"></a>
						<h2><a href="/travel">{{this.name}}</a></h2>
						<p>
							{{this.length}} &middot; {{this.resort}} &middot; ${{this.perPerson}} per person
						</p>
						{{{this.description}}}
					</li>
					{{/each}}
				</ul>
			</div>
		</div>
	</div>
</div>
